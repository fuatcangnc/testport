---
import { Icon } from "astro-icon/components";
import Brand from "./Brand.astro";
import { siteSettings } from "@/data/site";

const projectLinks = [
	["Gece Vardiyası", "/projeler/gece-vardiyasi"],
	["Tuz ve Toz", "/projeler/tuz-ve-toz"],
	["İskele Sesleri", "/projeler/iskele-sesleri"],
	["Tüm projeler", "/projeler"],
];

const siteLinks = [
	["Hakkımda", "/hakkinda"],
	["Hizmetler", "/#hizmetler"],
	["Süreç", "/#surec"],
	["SSS", "/#sss"],
	["İletişim", "/iletisim"],
];
---

<footer class="site-footer">
	<div class="shell footer-grid">
		<section class="footer-brand" aria-labelledby="footer-brand-title">
			<h2 class="sr-only" id="footer-brand-title">{siteSettings.brandName}</h2>
			<Brand inverse />
			<p>{siteSettings.description}</p>
			<ul class="trust-list" aria-label="Çalışma biçimi">
				<li>Uzun soluklu saha</li>
				<li>Caption & arşiv düzeni</li>
				<li>Yazılı kullanım lisansı</li>
			</ul>
			<ul class="social-list" aria-label="Sosyal medya hesapları">
				<li>
					<a aria-label="Instagram" href={siteSettings.instagram} target="_blank" rel="noreferrer">
						<Icon name="simple-icons:instagram" size={16} />
					</a>
				</li>
				<li>
					<a aria-label="X" href={siteSettings.x} target="_blank" rel="noreferrer">
						<Icon name="simple-icons:x" size={16} />
					</a>
				</li>
				<li>
					<a aria-label="LinkedIn" href={siteSettings.linkedin} target="_blank" rel="noreferrer">
						<Icon name="simple-icons:linkedin" size={16} />
					</a>
				</li>
			</ul>
		</section>

		<nav class="footer-column" aria-labelledby="footer-project-title">
			<h3 id="footer-project-title">Projeler</h3>
			<ul>
				{projectLinks.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
			</ul>
		</nav>

		<nav class="footer-column" aria-labelledby="footer-site-title">
			<h3 id="footer-site-title">Site</h3>
			<ul>{siteLinks.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
			<p class="footer-group-title">Notlar</p>
			<ul>
				<li><a href="/blog">Saha notları</a></li>
			</ul>
		</nav>

		<section class="footer-column footer-contact" aria-labelledby="footer-contact-title">
			<h3 id="footer-contact-title">İletişim</h3>
			<address>
				<a href={`mailto:${siteSettings.email}`}>
					<Icon name="lucide:mail" size={16} />
					<span><small>E-posta</small>{siteSettings.email}</span>
				</a>
				<div>
					<Icon name="lucide:map-pin" size={16} />
					<span><small>Üs</small>{siteSettings.location}</span>
				</div>
				<div>
					<Icon name="lucide:clock-3" size={16} />
					<span><small>Uygunluk</small>{siteSettings.workHours}</span>
				</div>
			</address>
		</section>
	</div>

	<div class="shell footer-bottom">
		<p>© {new Date().getFullYear()} {siteSettings.brandName}. Tüm fotoğrafların hakları saklıdır.</p>
		<p class="footer-credit">
			Fotoğraf &amp; site: <a href="/hakkinda" class="underline underline-offset-2 transition-colors hover:text-primary">Deniz Aksu</a>
		</p>
		<nav aria-label="Alt bağlantılar">
			<a href="/projeler">Projeler</a>
			<a href="/hakkinda">Hakkımda</a>
			<a href="/iletisim">İletişim</a>
		</nav>
	</div>
</footer>
