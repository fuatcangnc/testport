---
import { ArrowRight } from "@lucide/astro";
import type { Project } from "@/data/site";

interface Props {
	project: Project;
	index?: number;
	large?: boolean;
}

const { project, index = 0, large = false } = Astro.props;
const tones: Record<Project["tone"], string> = {
	blue: "bg-primary text-white",
	ink: "bg-[#0B0E11] text-white",
	ash: "bg-neutral-100 text-neutral-950",
};
---

<a
	href={`/projeler/${project.slug}`}
	class="group flex h-full flex-col border border-neutral-200 bg-white transition-all duration-200 hover:border-primary hover:shadow-[0_18px_40px_-24px_rgba(0,0,0,0.35)]"
>
	<div class:list={[tones[project.tone], "relative flex flex-col justify-between overflow-hidden", large ? "aspect-[4/5]" : "aspect-[5/4]", "p-5 sm:p-6"]}>
		<div class="pointer-events-none absolute inset-0 bg-[radial-gradient(currentColor_1px,transparent_1px)] [background-size:18px_18px] opacity-[0.14]" aria-hidden="true"></div>
		<div class="relative flex items-center justify-between font-mono text-[10px] font-bold uppercase tracking-[0.16em]">
			<span>{project.type}</span>
			<span>{project.number}</span>
		</div>
		<div class="relative flex items-end justify-between gap-4">
			<span class="font-mono text-[clamp(2.5rem,6vw,4.5rem)] font-black leading-none tracking-[-0.08em] opacity-25">
				{String(index + 1).padStart(2, "0")}
			</span>
			<span class="text-right font-mono text-[9px] uppercase leading-relaxed tracking-[0.14em] opacity-70">
				{project.location}<br />{project.year}
			</span>
		</div>
	</div>

	<div class="flex flex-1 flex-col p-5 sm:p-6">
		<h3 class="text-lg font-black uppercase leading-tight tracking-[-0.02em] text-neutral-950 transition-colors group-hover:text-primary sm:text-xl">
			{project.title}
		</h3>
		<p class="mt-2 line-clamp-3 text-sm leading-relaxed text-neutral-600">{project.summary}</p>
		<div class="mt-auto flex items-center justify-between border-t border-neutral-100 pt-4 text-[11px] font-black uppercase tracking-wider">
			<span class="text-neutral-500">{project.frames} kare</span>
			<span class="inline-flex items-center gap-1.5 text-primary transition-all group-hover:gap-2.5">
				Projeyi gör <ArrowRight size={14} />
			</span>
		</div>
	</div>
</a>
