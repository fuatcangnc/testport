---
import { ArrowUpRight, Mail, MapPin } from "@lucide/astro";
import { Icon } from "astro-icon/components";
import Base from "@/layouts/Base.astro";
import { faqs, siteSettings } from "@/data/site";
---

<Base title={`İletişim — ${siteSettings.brandName}`} description={siteSettings.description}>
	<main class="mx-auto w-[95vw] max-w-7xl pb-20 pt-10 sm:pt-14">
		<p class="font-mono text-[10px] font-black uppercase tracking-[0.18em] text-primary">İletişim</p>
		<h1 class="mt-3 max-w-4xl text-[clamp(2.8rem,7vw,6rem)] font-black uppercase leading-[0.9] tracking-[-0.07em] text-neutral-950">
			Bir fikir, bir <span class="text-primary">tarih</span>, bir soru.
		</h1>

		<div class="mt-10 grid gap-10 border-t border-neutral-200 pt-10 lg:grid-cols-[1fr_1fr]">
			<div>
				<p class="max-w-xl text-base leading-relaxed text-neutral-700">
					Yeni projeler, editoryal işler, baskı ve arşiv lisansı için doğrudan yazabilirsin. Brief’i kısa tutmak yeterli; gerisini birlikte netleştiririz.
				</p>

				<div class="mt-8 space-y-4">
					<a href={`mailto:${siteSettings.email}`} class="flex items-center gap-4 border border-neutral-200 p-4 transition-colors hover:border-primary">
						<Mail size={18} class="text-primary" />
						<span>
							<small class="block font-mono text-[9px] font-black uppercase tracking-[0.14em] text-neutral-500">E-posta</small>
							<span class="text-sm font-bold text-neutral-950">{siteSettings.email}</span>
						</span>
					</a>
					<div class="flex items-center gap-4 border border-neutral-200 p-4">
						<MapPin size={18} class="text-primary" />
						<span>
							<small class="block font-mono text-[9px] font-black uppercase tracking-[0.14em] text-neutral-500">Üs</small>
							<span class="text-sm font-bold text-neutral-950">{siteSettings.location}</span>
						</span>
					</div>
				</div>

				<div class="mt-6 flex gap-3">
					<a aria-label="Instagram" href={siteSettings.instagram} target="_blank" rel="noreferrer" class="flex size-10 items-center justify-center border border-neutral-200 text-neutral-700 hover:border-primary hover:text-primary">
						<Icon name="simple-icons:instagram" size={16} />
					</a>
					<a aria-label="X" href={siteSettings.x} target="_blank" rel="noreferrer" class="flex size-10 items-center justify-center border border-neutral-200 text-neutral-700 hover:border-primary hover:text-primary">
						<Icon name="simple-icons:x" size={16} />
					</a>
					<a aria-label="LinkedIn" href={siteSettings.linkedin} target="_blank" rel="noreferrer" class="flex size-10 items-center justify-center border border-neutral-200 text-neutral-700 hover:border-primary hover:text-primary">
						<Icon name="simple-icons:linkedin" size={16} />
					</a>
				</div>
			</div>

			<div class="border border-neutral-950 bg-neutral-950 p-6 text-white sm:p-8">
				<p class="font-mono text-[10px] font-black uppercase tracking-[0.18em] text-primary">Müsaitlik</p>
				<p class="mt-4 text-2xl font-black uppercase leading-tight tracking-[-0.04em]">Yeni proje alıyor.</p>
				<p class="mt-3 text-sm leading-relaxed text-white/60">
					Editoryal işler için 1–2 hafta, belgesel ve kurumsal işler için 4–6 hafta önceden yazmak saha planlamasını kolaylaştırır.
				</p>
				<a href={`mailto:${siteSettings.email}`} class="mt-6 inline-flex items-center gap-2 bg-primary px-5 py-3 text-xs font-black uppercase tracking-wider text-white transition-colors hover:bg-primary-dark">
					E-posta gönder <ArrowUpRight size={15} />
				</a>
			</div>
		</div>

		<section class="mt-16 border-t border-neutral-200 pt-10">
			<p class="font-mono text-[10px] font-black uppercase tracking-[0.18em] text-primary">Kısa cevaplar</p>
			<div class="mt-4 divide-y divide-neutral-200 border-y border-neutral-200">
				{
					faqs.slice(0, 4).map(([question, answer]) => (
						<details class="group py-4">
							<summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-sm font-black uppercase tracking-wide text-neutral-950">
								<span>{question}</span>
								<span class="text-primary transition-transform group-open:rotate-45">+</span>
							</summary>
							<p class="mt-3 max-w-2xl text-sm leading-relaxed text-neutral-600">{answer}</p>
						</details>
					))
				}
			</div>
		</section>
	</main>
</Base>
