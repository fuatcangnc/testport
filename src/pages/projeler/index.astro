---
import { ArrowLeft } from "@lucide/astro";
import Base from "@/layouts/Base.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { projects, siteSettings } from "@/data/site";
---

<Base title={`Projeler — ${siteSettings.brandName}`} description={siteSettings.description}>
	<main class="mx-auto w-[95vw] max-w-7xl pb-20 pt-10 sm:pt-14">
		<a href="/" class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-wider text-neutral-500 hover:text-primary">
			<ArrowLeft size={14} /> Ana sayfa
		</a>

		<div class="mt-10 flex flex-wrap items-end justify-between gap-4 border-b border-neutral-200 pb-6">
			<div>
				<p class="font-mono text-[10px] font-black uppercase tracking-[0.18em] text-primary">Arşiv</p>
				<h1 class="mt-2 text-4xl font-black uppercase tracking-[-0.05em] text-neutral-950 sm:text-6xl">Projeler</h1>
			</div>
			<p class="max-w-sm text-sm leading-relaxed text-neutral-500">Uzun soluklu belgeseller, editoryal seriler ve kurumsal işler. Her proje sahadan, siparişe özel.</p>
		</div>

		<div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{projects.map((project, index) => <ProjectCard project={project} index={index} />)}
		</div>
	</main>
</Base>
